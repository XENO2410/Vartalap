# ---- LLM (OpenRouter, OpenAI-compatible) ----
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=google/gemini-flash-1.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# ---- Embeddings (local, free) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ---- Reranker (optional) ----
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Vector store ----
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=vartalaap_kb

# ---- Retrieval knobs (mirrors doc §5.2/§5.3) ----
RETRIEVER_TOP_K_CANDIDATES=50
RETRIEVER_TOP_K_FINAL=5
FAQ_HIGH_CONFIDENCE=0.85
FAQ_MEDIUM_CONFIDENCE=0.60

# ---- Chat history ----
HISTORY_TURNS=2
HISTORY_RELEVANCE_THRESHOLD=0.80

# ---- Reflexion loop (doc §7.2) ----
REFLEXION_ENABLED=true
REFLEXION_MAX_ITERATIONS=2

# ---- Observability ----
OBSERVABILITY_LOG_DIR=./logs
OBSERVABILITY_STDOUT=true

# ---- FastAPI ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
